{
  "geode": "5.10.1",
  "gd": {
    "win": "2.2081",
    "mac": "2.2081"
  },
  "id": "local.separate_song",
  "name": "OBS Jukebox",
  "version": "v1.2.3",
  "developer": "babbur",
  "description": "Play a different song on your OBS stream than in game, with the OBS Jukebox plugin.",
  "links": {
    "source": "https://github.com/ethanrjs/OBSJukebox"
  },
  "issues": {
    "info": "Report problems on GitHub. Include your Geode log and say whether GD Sounds shows up in OBS.",
    "url": "https://github.com/ethanrjs/OBSJukebox/issues"
  },
  "settings": {
    "enabled": {
      "type": "bool",
      "name": "Enable OBS Jukebox",
      "default": true
    },
    "offset": {
      "type": "custom:obs-offset",
      "name": "Song offset (seconds)",
      "default": 0.0
    }
  },
  "tags": [
    "utility",
    "music"
  ],
  "dependencies": {
    "fleym.nongd": ">=v3.8.0",
    "geode.node-ids": {
      "version": ">=v1.23.0",
      "required": false
    }
  }
}
